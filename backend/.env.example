PORT=5000
MONGODB_URI=mongodb://localhost:27017/convenience_store
JWT_SECRET=doi-thanh-mot-chuoi-bi-mat-bat-ky
# Mật khẩu chung cho các tài khoản demo do seed tạo (chỉ dùng khi chạy npm run seed)
SEED_PASSWORD=Password@123
# Google Identity Services: cùng Client ID với VITE_GOOGLE_CLIENT_ID ở frontend/.env
GOOGLE_CLIENT_ID=
# Gửi email (Gmail: mật khẩu ứng dụng, không phải mật khẩu đăng nhập)
# Để SMTP_HOST trống: link quên mật khẩu in terminal, không gửi thông báo đơn.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# --- Thanh toán online (UC-08.2) ---
# Test nhanh KHÔNG cần tài khoản cổng thanh toán: đặt PAYMENT_MOCK=true để dùng trang thanh toán giả lập (tự tắt khi NODE_ENV=production)
PAYMENT_MOCK=true
# Số phút giữ hàng cho đơn chờ thanh toán online; quá hạn đơn chuyển "failed" và hoàn kho
PAYMENT_TTL_MINUTES=15
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ rồi điền TMN code + Hash secret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
# Optional mobile callback. Use a publicly reachable HTTPS backend in production.
# Defaults to /api/payments/vnpay/mobile-return on the VNPAY_RETURN_URL origin.
# VNPAY_MOBILE_RETURN_URL=https://api.example.com/api/payments/vnpay/mobile-return
