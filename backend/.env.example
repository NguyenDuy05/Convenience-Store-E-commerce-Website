PORT=5000
MONGODB_URI=mongodb://localhost:27017/convenience_store
JWT_SECRET=doi-thanh-mot-chuoi-bi-mat-bat-ky
# Mật khẩu chung cho các tài khoản demo do seed tạo (chỉ dùng khi chạy npm run seed)
SEED_PASSWORD=Password@123
# --- Thanh toán online (UC-08.2) ---
# Test nhanh KHÔNG cần tài khoản cổng thanh toán: đặt PAYMENT_MOCK=true để dùng trang thanh toán giả lập (tự tắt khi NODE_ENV=production)
PAYMENT_MOCK=true
# Số phút giữ hàng cho đơn chờ thanh toán online; quá hạn đơn chuyển "failed" và hoàn kho
PAYMENT_TTL_MINUTES=15
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ rồi điền TMN code + Hash secret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
# MoMo test: lấy thông tin tại https://developers.momo.vn/ (IPN cần URL công khai, local dùng ngrok; không có IPN vẫn nhận kết quả qua trang return)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5000/api/payments/momo/return
MOMO_IPN_URL=
